+	 * without a matching pre_overlay_malloc, and leaving a freed pointer
+	 * here turns that into a double free. */
+	if (buffer) {
 		FreePool(buffer);
+		buffer = NULL;
+	}
+	buffer_used = 0;
 }
 
 void *dto_malloc(size_t size) {
-	static int ssize = 0;
-        void *retbuf;
+	void *retbuf;
 
-	if (((MAX_UINT64 - ssize) < size) || ((ssize + size) > PRE_ALLOC_BUFFER_SZ)) {
