+	 * failure without ever reaching post_overlay_free), so never leak the
+	 * old buffer and never reuse its bump offset for a new allocation. */
+	if (buffer != NULL) {
+		FreePool(buffer);
+		buffer = NULL;
+	}
+	buffer_used = 0;
