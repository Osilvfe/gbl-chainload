# Session/tooling state
.claude/
.omc/
tests/*/.omc/

# Private firmware inputs and local investigation scratch data
/local/*
!/local/README.md

# Keep legacy local dumps ignored after the directory migration
/images/

# host-tool cross-compile artifacts
tools/*/*.exe
tools/*/*.pdb
tools/*/*-macos-x64
tools/*/*-macos-arm64

# Mode-2 profile payloads — gitignored; manifest.json is tracked (Plan 2)
profiles/*/profile.h
profiles/*/[!manifest]*.bin

# Device test logs
logs/
/log.txt

# RE staging (transient)
.re-notes-staging/

# Python
__pycache__/
*.pyc
.venv/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
